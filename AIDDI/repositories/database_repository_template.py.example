"""Template for a database-backed repository.

Copy this file when a feature is ready to move from file storage to PostgreSQL.
Rename it for the feature, for example `team_diagnostics_repository.py`.
"""

from services.database import connect


class ExampleRepository:
    def list_for_account(self, account_id: str) -> list[dict]:
        with connect() as conn:
            with conn.cursor() as cursor:
                cursor.execute(
                    """
                    SELECT id, title, created_at, updated_at
                    FROM example_table
                    WHERE account_id = %s
                    ORDER BY updated_at DESC
                    """,
                    (account_id,),
                )
                rows = cursor.fetchall()

        return [
            {
                "id": row[0],
                "title": row[1],
                "created_at": row[2],
                "updated_at": row[3],
            }
            for row in rows
        ]

    def create(self, account_id: str, title: str, content: str) -> str:
        with connect() as conn:
            with conn.cursor() as cursor:
                cursor.execute(
                    """
                    INSERT INTO example_table (account_id, title, content)
                    VALUES (%s, %s, %s)
                    RETURNING id
                    """,
                    (account_id, title, content),
                )
                new_id = cursor.fetchone()[0]
            conn.commit()

        return str(new_id)

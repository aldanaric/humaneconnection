# Selected provider used as the default when a new app session starts.
LLM_PROVIDER=gemini

# Legacy single-provider config. Still supported when LLM_PROVIDER matches.
LLM_API_KEY=YOUR_GEMINI_API_KEY
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Provider-specific config. If an API key is omitted here, the app will prompt
# for it and keep it only in Streamlit session memory.

# ---------- OpenAI ----------
# LLM_OPENAI_API_KEY=sk-...
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_MODEL=gpt-4.1-mini

# ---------- Gemini ----------
# LLM_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_GEMINI_MODEL=gemini-2.5-flash

# ---------- OpenRouter ----------
# LLM_OPENROUTER_API_KEY=sk-or-...
# LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_OPENROUTER_MODEL=openai/gpt-4.1-mini

# ---------- Other OpenAI-compatible endpoint ----------
# LLM_COMPATIBLE_API_KEY=your-api-key
# LLM_COMPATIBLE_BASE_URL=https://your-provider.example/v1
# LLM_COMPATIBLE_MODEL=provider-model-name

RAG_NUMERIC_THREADS=1
RAG_BUNDLE_DIR=data/rag/humane_connection_rag
RAG_TOP_K=5
RAG_DENSE_WEIGHT=0.35
RAG_MIN_SCORE=0

# ---------- PostgreSQL development database ----------
# Used by docker-compose.yml and services.database.
POSTGRES_DB=aiddi_dev
POSTGRES_USER=aiddi
POSTGRES_PASSWORD=change-me

# Use localhost when running the Streamlit app directly on your machine with
# `uv run streamlit run Home.py`. The docker-compose app service overrides this
# to POSTGRES_HOST=postgres inside Docker.
POSTGRES_HOST=localhost
# Use postgres only when the app itself is running in the same docker-compose.yml
# network as the postgres service.
# POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Local uv app:
# DATABASE_URL=postgresql://aiddi:change-me@localhost:5432/aiddi_dev
# Docker Compose app:
# DATABASE_URL=postgresql://aiddi:change-me@postgres:5432/aiddi_dev
# Hosted Neon Postgres / Streamlit Secrets:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
